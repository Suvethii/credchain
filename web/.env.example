# Copy to .env.local. These are PUBLIC (they go into the browser bundle). Never put PINATA_JWT here.
VITE_USE_MOCK=false            # true = in-browser fake contract + fake pin (no wallet tx, no Dev A needed)
VITE_CHAIN=sepolia             # sepolia | baseSepolia | local
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DEPLOY_BLOCK=0            # block of the deploy tx; event scans start here
VITE_RPC_URL=                  # Alchemy/Infura Sepolia URL (falls back to public RPC)
VITE_WC_PROJECT_ID=            # WalletConnect Cloud project id
VITE_PIN_URL=/api/pin          # Dev A's Vercel function
